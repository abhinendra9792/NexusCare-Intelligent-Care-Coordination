# =============================================
#  HealthCare Vault — .gitignore
# =============================================

# ---------- Dependencies ----------
node_modules/
frontend/node_modules/

# ---------- Environment Variables (NEVER COMMIT) ----------
.env
.env.local
.env.development
.env.production
.env.*.local
Backend/.env

# ---------- Sensitive / Debug Scripts ----------
check-all-tables.js
check-schema.js
create-share-tables.js
fix-chat-table.js
reset-db.js
test-db.js
test-gemini.js
test-nano-banana.js
Backend/create-test-user.js
Backend/test-db-connection.js

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Build Outputs ----------
dist/
build/
frontend/dist/
frontend/build/

# ---------- OS Files ----------
.DS_Store
Thumbs.db
*.swp
*.swo
ehthumbs.db
desktop.ini

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/

# ---------- Uploads (user uploaded medical files) ----------
uploads/*
!uploads/.gitkeep

# ---------- Database Files ----------
*.sql
*.db
*.sqlite
*.dump
database-schema-share-links.sql

# ---------- Test Coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Temporary Files ----------
tmp/
temp/
*.tmp

# ---------- Package Locks ----------
package-lock.json
frontend/package-lock.json
yarn.lock

# ---------- Gemini / AI Tool Caches ----------
.gemini/
